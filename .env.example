# ─────────────────────────────────────────────────────────────────
# 币安期权交易历史系统 - 环境变量配置
# 复制此文件为 .env.local（本地开发）或在 Vercel Dashboard 中配置
# ─────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────
# 【必填】数据库连接（Vercel Postgres）
# ──────────────────────────────────────────
# 在 Vercel Dashboard → Storage → Postgres 中创建数据库后，
# 复制 POSTGRES_URL 连接串粘贴到这里
POSTGRES_URL=postgres://user:password@host:5432/database?sslmode=require

# 或使用 Supabase 直连（Session Mode，端口 5432）
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────
# 【必填】币安 API 密钥（只读权限）
# ──────────────────────────────────────────
# 1. 登录 https://www.binance.com/zh-CN/my/settings/api-management
# 2. 创建 API Key，勾选「允许读取」权限
# 3. 如果服务器有固定 IP，建议在「IP 访问限制」中填写服务器 IP
# 4. 绝对不要勾选交易权限！只需只读权限
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ──────────────────────────────────────────
# 【可选】Supabase（原有交易记录系统使用）
# ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ──────────────────────────────────────────
# Next.js 内置
# ──────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
