# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 访问控制（可选）
# 不设置时应用完全开放，适合本机使用。
# 设置后，访问任何页面或接口都需要先输入该密码（会话保存 30 天）。
# APP_PASSWORD=

# 注意：本应用通过 Supabase 的 anon key 直连数据库，
# 请务必在 Supabase 控制台为 accounts / trades / fund_records / balance / equity_history
# 开启 RLS 并配置对应策略，否则任何拿到 anon key 的人都能读写全部数据。
# 迁移脚本见 assets/migrations/001_fix_account_scope.sql
